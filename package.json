{
  "name": "igo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "artifact": "node scripts/inline-artifact.mjs",
    "cap:sync": "npm run build && cap sync",
